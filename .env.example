# === Publico (tambien se usan en build Docker) ===
NEXT_PUBLIC_SITE_URL=https://demo-agricultura.tuempresa.com
NEXT_PUBLIC_USE_DOGRAH=false

# RUT por WhatsApp (solo servidor; el cliente consulta /api/agent/whatsapp-rut)
WHATSAPP_RUT_NUMBER=5492613417054
WHATSAPP_RUT_TEXT=Hola, quiero registrarme en el RUT de Mendoza. Me derivaron desde la demo de Agricultura.
WHATSAPP_ODK_TEXT=Hola, estoy en campo. Quiero cargar un formulario por WhatsApp: olivo encontrado o visita técnica.

# === Secreto puente HTTP (Dograh / tools) ===
DEMO_AGENT_SECRET=cambiar-por-secreto-fuerte
DEMO_SESSION_SECRET=cambiar-por-otro-secreto-fuerte

# === Cerebro + STT (rápido: navegador + Speaches local; Gemini solo si STT_PROVIDER=gemini) ===
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
GEMINI_STT_MODEL=gemini-3.6-flash
# local (default) | gemini | speaches | elevenlabs
STT_PROVIDER=local
# TTS rápido con voz del navegador (false = ElevenLabs en respuestas locales)
VOICE_FAST_TTS=true

# Speaches/faster-whisper local (fallback si el dictado del navegador falla)
SPEACHES_URL=http://127.0.0.1:8771

# === Voz (ElevenLabs) ===
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=h60rOzgfLmYsntfqgGu2
ELEVENLABS_MODEL_ID=eleven_flash_v2_5
# Demo 3 min (mejor calidad / pronunciacion)
ELEVENLABS_TOUR_MODEL_ID=eleven_multilingual_v2

# STT local opcional (fallback si Gemini falla). Speaches + faster-whisper.
SPEACHES_URL=http://127.0.0.1:8771
# Docker Linux: http://host.docker.internal:8771
SPEACHES_DOCKER_URL=http://host.docker.internal:8771
SPEACHES_STT_MODEL=Systran/faster-whisper-small

USE_N8N_AS_BRAIN=true
N8N_WEBHOOK_URL=https://n8n.followlsn.com/webhook/demo-agricultura
N8N_BASE_URL=https://n8n.followlsn.com
# Local n8n (desarrollo):
# N8N_WEBHOOK_URL=http://127.0.0.1:5678/webhook/demo-agricultura
# N8N_BASE_URL=http://127.0.0.1:5678
# Docker Linux:
N8N_DOCKER_WEBHOOK_URL=https://n8n.followlsn.com/webhook/demo-agricultura
N8N_DOCKER_BASE_URL=http://host.docker.internal:5678
N8N_API_KEY=

# Dograh embed (solo si NEXT_PUBLIC_USE_DOGRAH=true)
NEXT_PUBLIC_DOGRAH_EMBED_URL=

# === Nuevo motor de voz modular ===
# Runtime: browser | elevenlabs | openai-realtime | livekit
# browser = STT/TTS nativo del navegador (rápido, gratuito, sin API key).
# elevenlabs = TTS premium vía /api/agent/tts (requiere ELEVENLABS_API_KEY).
# openai-realtime = WebRTC bidireccional (requiere OPENAI_API_KEY).
# livekit = LiveKit Agents (requiere LIVEKIT_URL y LIVEKIT_TOKEN).
NEXT_PUBLIC_VOICE_RUNTIME=browser
NEXT_PUBLIC_LEGACY_VOICE_ASSISTANT=false

# OpenAI Realtime
OPENAI_API_KEY=

# LiveKit (self-host o cloud)
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
